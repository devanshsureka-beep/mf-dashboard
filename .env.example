# =============================================================================
# MN Advisory Dashboard — environment variables
# Copy to .env.local for local development. NEVER commit real values.
# Variables WITHOUT the NEXT_PUBLIC_ prefix are server-only.
# =============================================================================

# --- Sign-in -------------------------------------------------------------------
# "supabase" (default): Supabase Auth. "app": the app checks passwords and keeps
# its own sessions (lib/auth). Same users either way: switching back is only this.
AUTH_MODE=supabase
# AUTH_MODE=app only. Keys the session and link hashes. SERVER ONLY, 32+ chars:
# openssl rand -hex 32. Changing it signs everyone out and voids open links.
SESSION_SECRET=
# Optional search_path for every transaction, e.g. "public, app, extensions".
# Queries name their schema explicitly, so this does not move them to another schema.
DB_SEARCH_PATH=

# --- Email for reset / invite links (AUTH_MODE=app). SERVER ONLY -----------------
# Sender address and its mailbox's SMTP (Google Workspace: smtp.gmail.com, 465,
# the mailbox address and an app password). Changing the sender later is only
# EMAIL_FROM and SMTP_USER (and its password).
EMAIL_FROM=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=

# --- Supabase (Project Settings -> API) --------------------------------------
# AUTH_MODE=supabase only: the browser-side URL and public anon / publishable key.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# The project URL for server-side storage. Required with AUTH_MODE=app (falls
# back to NEXT_PUBLIC_SUPABASE_URL otherwise).
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Service-role / secret key. SERVER ONLY. Used for storage (uploads, signed
# links, file staging; in AUTH_MODE=app after the app's own access check),
# staff users in AUTH_MODE=supabase, and integration endpoints.
SUPABASE_SERVICE_ROLE_KEY=

# --- Postgres (Project Settings -> Database -> Connection string) ------------
# Use the *transaction pooler* URI (port 6543) on Vercel. SERVER ONLY.
DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# --- App ---------------------------------------------------------------------
# "staging" on the test site (Vercel Preview) shows a TEST banner. Leave empty on production.
APP_ENV=

# Public base URL of this app (used in callback URLs sent to n8n).
APP_BASE_URL=http://localhost:3000

# --- n8n integration ---------------------------------------------------------
# Token n8n must send as "Authorization: Bearer <token>" to /api/integrations/*.
# Generate with: openssl rand -hex 32
INTEGRATION_API_KEY=
# Optional outbound webhooks (leave empty to disable).
N8N_CAS_PARSE_WEBHOOK_URL=
N8N_ADVISORY_PARSE_WEBHOOK_URL=
N8N_NOTIFICATION_WEBHOOK_URL=
# Token this app sends to n8n webhooks (configure n8n "Header Auth" with it).
N8N_WEBHOOK_TOKEN=

# --- CAS PDFs ------------------------------------------------------------------
# Password pattern of your clients' CAS PDFs; {last4} = last 4 digits of the
# client's mobile number (e.g. Prefix{last4}$). Server-only; never NEXT_PUBLIC_.
CAS_PASSWORD_TEMPLATE=

# --- Claude report reader (Bulk Onboarding) -----------------------------------
# n8n webhook (workflow "Univest MF Desk - Report reader (Claude)") that holds
# the Anthropic key, and the shared header key (n8n Header Auth credential,
# header name X-Desk-Key). Both empty = reports that do not reconcile are
# listed for review instead of being read by Claude. Server-only.
REPORT_AI_URL=
REPORT_AI_KEY=

# --- Seed script only ---------------------------------------------------------
# Password given to demo users created by `npm run seed` (12+ characters).
# Dev/staging only: the seed refuses the production database.
SEED_DEMO_PASSWORD=
