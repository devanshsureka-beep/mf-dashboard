# =============================================================================
# MN Advisory Dashboard — environment variables
# Copy to .env.local for local development. NEVER commit real values.
# Variables WITHOUT the NEXT_PUBLIC_ prefix are server-only.
# =============================================================================

# --- Supabase (Project Settings -> API) --------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Public anon / publishable key. Safe for the browser; RLS protects data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role / secret key. SERVER ONLY. Used for: creating staff users,
# storage operations from integration endpoints, and the seed script.
SUPABASE_SERVICE_ROLE_KEY=

# --- Postgres (Project Settings -> Database -> Connection string) ------------
# Use the *transaction pooler* URI (port 6543) on Vercel. SERVER ONLY.
DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# --- App ---------------------------------------------------------------------
# "staging" on the test site (Vercel Preview) shows a TEST banner. Leave empty on production.
APP_ENV=

# Public base URL of this app (used in callback URLs sent to n8n).
APP_BASE_URL=http://localhost:3000

# --- n8n integration ---------------------------------------------------------
# Token n8n must send as "Authorization: Bearer <token>" to /api/integrations/*.
# Generate with: openssl rand -hex 32
INTEGRATION_API_KEY=
# Optional outbound webhooks (leave empty to disable).
N8N_CAS_PARSE_WEBHOOK_URL=
N8N_ADVISORY_PARSE_WEBHOOK_URL=
N8N_NOTIFICATION_WEBHOOK_URL=
# Token this app sends to n8n webhooks (configure n8n "Header Auth" with it).
N8N_WEBHOOK_TOKEN=

# --- CAS PDFs ------------------------------------------------------------------
# Password pattern of your clients' CAS PDFs; {last4} = last 4 digits of the
# client's mobile number (e.g. Prefix{last4}$). Server-only; never NEXT_PUBLIC_.
CAS_PASSWORD_TEMPLATE=

# --- Seed script only ---------------------------------------------------------
# Password given to demo users created by `npm run seed`. Dev/staging only.
SEED_DEMO_PASSWORD=
